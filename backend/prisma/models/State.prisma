/// 1. states: Administrative states/UTs
model State {
  state_id   Int        @id @default(autoincrement()) @map("state_id")
  state_name String     @unique @map("state_name") @db.VarChar(100)
  type       String?    @map("type") @db.VarChar(20)

  // Relationships
  districts  District[]
  mps        Mp[]
  users      User[]
  works      Work[]

  @@map("states")
}
